{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "printWidth": 80,
  "trailingComma": "es5",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".plans/**",
    ".repos/**",
    ".roo/**",
    ".windsurf/**",
    "apps/mediapeek/app/components/ui/**",
    "apps/mediapeek-analyzer/src/lib/mediainfo-bundle.js",
    "apps/mediapeek/app/lib/mediainfo-bundle.js",
    "tools/oxlint/anti-slop/**",
    "**/worker-configuration.d.ts",
    "node_modules",
    "build",
    "dist",
    ".wrangler",
    ".react-router",
    "sample",
    "public/build",
    "*.d.ts"
  ],
  "tailwindStylesheet": "packages/ui/src/styles/globals.css",
  "tailwindFunctions": ["cn", "cva"],
  "sortImports": true
}
