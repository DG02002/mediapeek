{
  "$schema": "./node_modules/knip/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs}"],
      "project": ["scripts/**/*.{ts,mjs}"]
    },
    "apps/mediapeek": {
      "entry": ["app/router.tsx"],
      "ignoreDependencies": ["cloudflare"],
      "paths": {
        "~/*": ["./app/*"]
      },
      "project": [
        "app/**/*.{ts,tsx}!",
        "app/**/*.css!",
        "!app/test/**!",
        "*.{ts,tsx,mjs}"
      ],
      "ignoreIssues": {
        "app/components/ui/**/*.tsx": ["exports"],
        "app/lib/logger.server.ts": ["exports", "types"],
        "app/routes/app/compare/route.tsx": ["types"]
      }
    },
    "apps/mediapeek-analyzer": {
      "project": ["src/**/*.ts", "*.{ts,tsx,mjs}"]
    },
    "packages/shared": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
