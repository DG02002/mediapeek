{
  "name": "mediapeek-analyzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "postinstall": "pnpm run cf-typegen",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "lint": "cd ../.. && oxlint --config .oxlintrc.json apps/mediapeek-analyzer",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.2",
    "@mediapeek/shared": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "hono": "^4.12.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@mediapeek/config-typescript": "workspace:*",
    "@types/node": "^25.6.2",
    "mediainfo.js": "^0.3.7",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
