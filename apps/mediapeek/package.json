{
  "name": "mediapeek",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "build": "react-router build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "react-router dev",
    "deploy": "pnpm build && wrangler deploy",
    "start": "wrangler dev",
    "postinstall": "pnpm run cf-typegen",
    "typecheck": "react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "lint": "cd ../.. && oxlint --config .oxlintrc.json apps/mediapeek",
    "test": "vitest",
    "clean": "rm -rf build .react-router node_modules"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.2",
    "@mediapeek/shared": "workspace:*",
    "@mediapeek/ui": "workspace:*",
    "clsx": "^2.1.1",
    "effect": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.12.18",
    "isbot": "^5.1.40",
    "motion": "^12.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.0",
    "remix-themes": "^2.0.4",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.3",
    "@cloudflare/workers-types": "catalog:",
    "@mediapeek/config-typescript": "workspace:*",
    "@react-router/dev": "^7.15.0",
    "@react-router/node": "^7.15.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "mediapeek-analyzer": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
