{
  "name": "mediapeek",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "build": "react-router build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "react-router dev",
    "deploy": "pnpm build && wrangler deploy",
    "start": "wrangler dev",
    "postinstall": "pnpm run cf-typegen",
    "typecheck": "react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "lint": "cd ../.. && oxlint --config .oxlintrc.json apps/mediapeek",
    "test": "vitest",
    "clean": "rm -rf build .react-router node_modules"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@mediapeek/shared": "workspace:*",
    "@mediapeek/ui": "workspace:*",
    "clsx": "^2.1.1",
    "effect": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.13",
    "isbot": "^5.2.2",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "remix-themes": "^2.0.4",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "catalog:",
    "@mediapeek/config-typescript": "workspace:*",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mediapeek-analyzer": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
