{
  "name": "mediapeek",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "build": "vite build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "vite dev",
    "deploy": "pnpm build && wrangler deploy",
    "start": "wrangler dev",
    "postinstall": "pnpm run cf-typegen",
    "generate-routes": "vite build && oxfmt app/routeTree.gen.ts",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types",
    "lint": "cd ../.. && oxlint --config .oxlintrc.json apps/mediapeek",
    "test": "vitest",
    "clean": "rm -rf dist .wrangler node_modules"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@mediapeek/shared": "workspace:*",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.13",
    "modern-screenshot": "^4.7.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "latest",
    "@cloudflare/workers-types": "catalog:",
    "@mediapeek/config-typescript": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
